{
  "manifest_version": 3,
  "name": "TextLift",
  "version": "1.0.0",
  "description": "Pick and copy text from buttons, tabs, links, and labels on demand.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "offscreen"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "TextLift — pick text",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L", "mac": "Alt+Shift+L" }
    }
  },
  "options_ui": { "page": "guide.html", "open_in_tab": true }
}
